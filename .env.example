# Placeholders below are deliberately NOT valid-looking. The previous set
# ("globalocal", "change-me", a 52-char JWT string) read like real values and
# were copied into production verbatim, where they stayed — anyone with this
# file could mint an admin token offline. Generate every one of them:
#     openssl rand -base64 48        # JWT_SECRET
#     openssl rand -base64 18        # passwords

# --- Postgres ---
POSTGRES_DB=kazus
POSTGRES_USER=kazus
POSTGRES_PASSWORD=<CHANGE_ME_GENERATE_RANDOM>


# --- Ports (host-side) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Auth ---
# Rotating JWT_SECRET invalidates every issued token, which is the point:
# it is also the only way to revoke one that leaked.
JWT_SECRET=<CHANGE_ME_GENERATE_RANDOM>
# Changing ADMIN_USERNAME does not rename the admin — _ensure_admin matches on
# the name, so a new user appears and the OLD one survives with its old
# password. Rotate ADMIN_PASSWORD instead; the hash is rewritten on startup.
ADMIN_USERNAME=<CHANGE_ME>
ADMIN_PASSWORD=<CHANGE_ME_GENERATE_RANDOM>

# --- Defaults ---
# CSV list of Binance USDT-M Futures symbols seeded on first boot.
DEFAULT_COINS=BTCUSDT,ETHUSDT,SOLUSDT,AAVEUSDT,ADAUSDT,AIXBTUSDT,APTUSDT,ARBUSDT,ARKMUSDT,ASTERUSDT,ATOMUSDT,AVAXUSDT,BERAUSDT,BNBUSDT,1000BONKUSDT,DASHUSDT,DOGEUSDT,DOTUSDT,ENAUSDT,ENSUSDT,ETCUSDT,FARTCOINUSDT,FETUSDT,1000FLOKIUSDT,GRASSUSDT,GRTUSDT,HBARUSDT,ICPUSDT,IMXUSDT,INJUSDT,JTOUSDT,JUPUSDT,KAITOUSDT,LDOUSDT,LINKUSDT,LTCUSDT,NEARUSDT,ONDOUSDT,OPUSDT,ORDIUSDT,PENDLEUSDT,PENGUUSDT,1000PEPEUSDT,PNUTUSDT,POPCATUSDT,PUMPUSDT,PYTHUSDT,RENDERUSDT,SEIUSDT,1000SHIBUSDT,SUIUSDT,SUSDT,TAOUSDT,TIAUSDT,TONUSDT,TRXUSDT,TURBOUSDT,UNIUSDT,VANRYUSDT,VETUSDT,VIRTUALUSDT,WIFUSDT,WLDUSDT,WUSDT,XLMUSDT,XMRUSDT,XRPUSDT,ZECUSDT,ZENUSDT,ZKUSDT,ZROUSDT

# --- CORS ---
# JSON list of allowed origins. Leave empty unless a browser on a DIFFERENT
# origin must call this API — the bundled frontend does not, it calls /api on
# a relative path behind a proxy. Never set ["*"]: allow_credentials is off,
# but a wildcard still hands the API to any site a logged-in operator visits.
CORS_ORIGINS=[]

# --- Worker ---
REFRESH_INTERVAL_SEC=300
# Timeframes for which Telegram OTE alerts are sent. Comma-separated.
ALERT_TIMEFRAMES=D1,H1

# --- Telegram ---
# Leave empty to disable alerts (worker logs them instead).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
