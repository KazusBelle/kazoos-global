//@version=5
indicator("Kazus Local (beta)", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=4900, max_boxes_count=500)

settings = "Settings"
zigzag_len = input.int(40, "ZigZag Length", group=settings)
show_zigzag = input.bool(true, "Show Zigzag", group=settings)
zigzag_color = input.color(color.blue, "ZigZag Line Color", group=settings)
zigzag_width = input.int(2, "ZigZag Line Width", group=settings, minval=1, maxval=5)
show_labels = input.bool(true, "Show HH, HL, LL, LH Labels", group=settings)
fib_factor = input.float(0.33, "Fib Factor for breakout confirmation", 0, 1, 0.01, group=settings)
text_size = input.string(size.tiny, "Text Size", [size.tiny, size.small, size.normal, size.large, size.huge], group=settings)

label_colors = "Structure Colors"
bull_bg_color = input.color(color.rgb(76, 175, 79, 75), "HH / HL Bg", group=label_colors, inline="bull")
bull_text_color = input.color(color.green, "Text", group=label_colors, inline="bull")
bear_bg_color = input.color(color.rgb(255, 0, 0, 75), "LH / LL Bg", group=label_colors, inline="bear")
bear_text_color = input.color(color.red, "Text", group=label_colors, inline="bear")

fib_group = "Fibonacci"
fib_display = input.string("Both", "Show Fib", options=["Long", "Short", "Both"], group=fib_group)
fib_style = input.string("Full Width", "Fibonacci Display Style", options=["Full Width", "Right Side"], group=fib_group)
fib_length = input.int(500, "Fibonacci Line Length (Full Width)", minval=1, group=fib_group)
fib_line_width = input.int(2, "Fib Line Width", minval=1, maxval=5, group=fib_group)
fib_right_offset = input.int(70, "Right Offset (Right Side)", minval=0, maxval=400, group=fib_group)
fib_right_length = input.int(50, "Line Length (Right Side)", minval=1, maxval=400, group=fib_group)
show_fib_labels = input.bool(true, "Show Fib Labels (Right Side)", group=fib_group)
fib_label_size = input.string(size.tiny, "Fib Label Size", [size.tiny, size.small, size.normal, size.large], group=fib_group)

fib_colors = "Fib Colors"
fibColor_0   = input.color(color.new(color.gray, 20), "0.0", group=fib_colors, inline="row1")
fibColor_236 = input.color(color.new(color.black, 100), "0.236", group=fib_colors, inline="row1")
fibColor_382 = input.color(color.new(color.black, 100), "0.382", group=fib_colors, inline="row2")
fibColor_500 = input.color(color.rgb(92, 123, 213), "0.5", group=fib_colors, inline="row2")
fibColor_618 = input.color(color.rgb(16, 122, 104), "0.618", group=fib_colors, inline="row3")
fibColor_705 = input.color(color.rgb(16, 122, 104), "0.705", group=fib_colors, inline="row3")
fibColor_786 = input.color(color.rgb(16, 122, 104), "0.786", group=fib_colors, inline="row4")
fibColor_100 = input.color(color.new(color.gray, 20), "1.0", group=fib_colors, inline="row4")

var float[] high_points_arr = array.new_float()
var int[] high_index_arr = array.new_int()
var float[] low_points_arr = array.new_float()
var int[] low_index_arr = array.new_int()

var line[] bullFibLines = array.new_line()
var line[] bearFibLines = array.new_line()
var label[] bullFibLabels = array.new_label()
var label[] bearFibLabels = array.new_label()

var label hhStarLabel = na
var float hhStarPrice = na
var int hhStarIndex = na

var label llStarLabel = na
var float llStarPrice = na
var int llStarIndex = na

var float current_up_high = na
var int current_up_high_index = na
var float current_down_low = na
var int current_down_low_index = na

var bool bullFibActive = false
var float bullFibLow = na
var float bullFibHigh = na
var int bullFibLowIndex = na
var int bullFibHighIndex = na

var bool bearFibActive = false
var float bearFibHigh = na
var float bearFibLow = na
var int bearFibHighIndex = na
var int bearFibLowIndex = na

f_clear_lines(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            line.delete(array.get(arr, i))
        array.clear(arr)

f_clear_labels(arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

to_up = high >= ta.highest(zigzag_len)
to_down = low <= ta.lowest(zigzag_len)

trend = 1
trend := nz(trend[1], 1)
trend := trend == 1 and to_down ? -1 : trend == -1 and to_up ? 1 : trend

last_trend_up_since = ta.barssince(to_up[1])
low_val = ta.lowest(nz(last_trend_up_since > 0 ? last_trend_up_since : 1))
low_index = bar_index - ta.barssince(low_val == low)

last_trend_down_since = ta.barssince(to_down[1])
high_val = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1))
high_index = bar_index - ta.barssince(high_val == high)

if ta.change(trend) != 0
    if trend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if trend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)

h0 = array.size(high_points_arr) > 0 ? array.get(high_points_arr, array.size(high_points_arr) - 1) : na
h0i = array.size(high_index_arr) > 0 ? array.get(high_index_arr, array.size(high_index_arr) - 1) : na
h1 = array.size(high_points_arr) > 1 ? array.get(high_points_arr, array.size(high_points_arr) - 2) : na

l0 = array.size(low_points_arr) > 0 ? array.get(low_points_arr, array.size(low_points_arr) - 1) : na
l0i = array.size(low_index_arr) > 0 ? array.get(low_index_arr, array.size(low_index_arr) - 1) : na
l1 = array.size(low_points_arr) > 1 ? array.get(low_points_arr, array.size(low_points_arr) - 2) : na

bool isHH = false
bool isLH = false
bool isLL = false
bool isHL = false

if trend == 1
    if na(current_up_high) or high >= current_up_high
        current_up_high := high
        current_up_high_index := bar_index

if trend == -1
    if na(current_down_low) or low <= current_down_low
        current_down_low := low
        current_down_low_index := bar_index

if trend == 1 and not na(h0) and not na(l0) and not na(current_up_high) and current_up_high > h0 and l0i < current_up_high_index
    bullFibActive := true
    bullFibLow := l0
    bullFibLowIndex := l0i
    bullFibHigh := current_up_high
    bullFibHighIndex := current_up_high_index

    if show_labels
        if na(hhStarLabel) or hhStarPrice != current_up_high or hhStarIndex != current_up_high_index
            if not na(hhStarLabel)
                label.delete(hhStarLabel)
            hhStarLabel := label.new(current_up_high_index, current_up_high, "HH*", color=bull_bg_color, textcolor=bull_text_color, size=text_size, style=label.style_label_down)
            hhStarPrice := current_up_high
            hhStarIndex := current_up_high_index

if trend == -1 and not na(l0) and not na(h0) and not na(current_down_low) and current_down_low < l0 and h0i < current_down_low_index
    bearFibActive := true
    bearFibHigh := h0
    bearFibHighIndex := h0i
    bearFibLow := current_down_low
    bearFibLowIndex := current_down_low_index

    if show_labels
        if na(llStarLabel) or llStarPrice != current_down_low or llStarIndex != current_down_low_index
            if not na(llStarLabel)
                label.delete(llStarLabel)
            llStarLabel := label.new(current_down_low_index, current_down_low, "LL*", color=bear_bg_color, textcolor=bear_text_color, size=text_size, style=label.style_label_up)
            llStarPrice := current_down_low
            llStarIndex := current_down_low_index

if bullFibActive and not na(bullFibLow) and low < bullFibLow
    bullFibActive := false

if bearFibActive and not na(bearFibHigh) and high > bearFibHigh
    bearFibActive := false

if ta.change(trend) != 0
    if show_zigzag
        if trend == 1 and not na(h0) and not na(l0)
            line.new(h0i, h0, l0i, l0, color=zigzag_color, width=zigzag_width, style=line.style_solid, extend=extend.none)
        if trend == -1 and not na(h0) and not na(l0)
            line.new(l0i, l0, h0i, h0, color=zigzag_color, width=zigzag_width, style=line.style_solid, extend=extend.none)

    if trend == 1
        current_up_high := high
        current_up_high_index := bar_index

        if not na(l0) and not na(l1)
            if l0 < l1
                isLL := true
                if not na(llStarLabel)
                    label.delete(llStarLabel)
                    llStarLabel := na
                    llStarPrice := na
                    llStarIndex := na
                if show_labels
                    label.new(l0i, l0, "LL", color=bear_bg_color, textcolor=bear_text_color, size=text_size, style=label.style_label_up)
                bearFibActive := true
                bearFibHigh := h0
                bearFibHighIndex := h0i
                bearFibLow := l0
                bearFibLowIndex := l0i
            else
                isHL := true
                if not na(llStarLabel)
                    label.delete(llStarLabel)
                    llStarLabel := na
                    llStarPrice := na
                    llStarIndex := na
                if show_labels
                    label.new(l0i, l0, "HL", color=bull_bg_color, textcolor=bull_text_color, size=text_size, style=label.style_label_up)

    if trend == -1
        current_down_low := low
        current_down_low_index := bar_index

        if not na(h0) and not na(h1)
            if h0 > h1
                isHH := true
                if not na(hhStarLabel)
                    label.delete(hhStarLabel)
                    hhStarLabel := na
                    hhStarPrice := na
                    hhStarIndex := na
                if show_labels
                    label.new(h0i, h0, "HH", color=bull_bg_color, textcolor=bull_text_color, size=text_size, style=label.style_label_down)
                bullFibActive := true
                bullFibLow := l0
                bullFibLowIndex := l0i
                bullFibHigh := h0
                bullFibHighIndex := h0i
            else
                isLH := true
                if not na(hhStarLabel)
                    label.delete(hhStarLabel)
                    hhStarLabel := na
                    hhStarPrice := na
                    hhStarIndex := na
                if show_labels
                    label.new(h0i, h0, "LH", color=bear_bg_color, textcolor=bear_text_color, size=text_size, style=label.style_label_down)

showBullishFibs = fib_display == "Long" or fib_display == "Both"
showBearishFibs = fib_display == "Short" or fib_display == "Both"

if barstate.islast
    f_clear_lines(bullFibLines)
    f_clear_lines(bearFibLines)
    f_clear_labels(bullFibLabels)
    f_clear_labels(bearFibLabels)

    fibColors = array.from(fibColor_0, fibColor_236, fibColor_382, fibColor_500, fibColor_618, fibColor_705, fibColor_786, fibColor_100)
    fibTexts = array.from("0.0", "0.236", "0.382", "0.5", "0.618", "0.705", "0.786", "1.0")

    if showBullishFibs and bullFibActive and not na(bullFibLow) and not na(bullFibHigh) and bullFibLowIndex < bullFibHighIndex
        bull_x1 = fib_style == "Right Side" ? bar_index + fib_right_offset - fib_right_length : bullFibLowIndex
        bull_x2 = fib_style == "Right Side" ? bar_index + fib_right_offset : bullFibLowIndex + fib_length

        fib0 = bullFibHigh
        fib100 = bullFibLow

        bullPrices = array.from(
             fib0,
             fib0 + (fib100 - fib0) * 0.236,
             fib0 + (fib100 - fib0) * 0.382,
             fib0 + (fib100 - fib0) * 0.5,
             fib0 + (fib100 - fib0) * 0.618,
             fib0 + (fib100 - fib0) * 0.705,
             fib0 + (fib100 - fib0) * 0.786,
             fib100
         )

        for i = 0 to array.size(bullPrices) - 1
            p = array.get(bullPrices, i)
            c = array.get(fibColors, i)
            t = array.get(fibTexts, i)
            array.push(bullFibLines, line.new(bull_x1, p, bull_x2, p, color=c, width=fib_line_width))

    if showBearishFibs and bearFibActive and not na(bearFibHigh) and not na(bearFibLow) and bearFibHighIndex < bearFibLowIndex
        bear_x1 = fib_style == "Right Side" ? bar_index + fib_right_offset - fib_right_length : bearFibHighIndex
        bear_x2 = fib_style == "Right Side" ? bar_index + fib_right_offset : bearFibHighIndex + fib_length

        fib0 = bearFibLow
        fib100 = bearFibHigh

        bearPrices = array.from(
             fib0,
             fib0 - (fib0 - fib100) * 0.236,
             fib0 - (fib0 - fib100) * 0.382,
             fib0 - (fib0 - fib100) * 0.5,
             fib0 - (fib0 - fib100) * 0.618,
             fib0 - (fib0 - fib100) * 0.705,
             fib0 - (fib0 - fib100) * 0.786,
             fib100
         )

        for i = 0 to array.size(bearPrices) - 1
            p = array.get(bearPrices, i)
            c = array.get(fibColors, i)
            t = array.get(fibTexts, i)
            array.push(bearFibLines, line.new(bear_x1, p, bear_x2, p, color=c, width=fib_line_width))
